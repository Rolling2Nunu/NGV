  <diagram id="state-machine" name="Page-2 (상태전이 State Machine Diagram)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s_title" value="ENG-SWE3-001 — 상태전이 상세 (MOD-STATE-001, FN-STATE-001 update_state)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1000" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="s_boundary" value="StateManager.self._state (SwState) — 단일 소유(MOD-STATE-001)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;strokeWidth=2;strokeColor=#2F75B5;fillColor=#F5F9FD;fontColor=#595959;fontSize=13;verticalAlign=top;spacingTop=14;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="960" height="380" as="geometry"/>
        </mxCell>

        <mxCell id="s_initial" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="130" y="240" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="s_normal" value="NORMAL&#10;(모든 필수 안전 관련 입력 FRESH)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#2F75B5;strokeWidth=2;fontColor=#000000;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="190" width="280" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="s_degraded" value="DEGRADED&#10;(하나 이상 필수 안전 관련 입력 STALE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDE9D9;strokeColor=#C0504D;strokeWidth=2;fontColor=#000000;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="190" width="280" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="s_e0" value="StateManager.__init__&#10;(초기값 NORMAL, 가정 — 확인 필요)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="s_initial" target="s_normal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s_e1" value="가드: any(r.freshness==STALE for r in results)&#10;FN-STATE-001 update_state() 호출&#10;100 ms 이내 전이(REQ-SW-F-005)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_normal" target="s_degraded">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s_e2" value="가드: 전부 FRESH AND _evaluate_recovery_policy()==True&#10;[TODO — 현재 미구현, 항상 False 반환]&#10;근거 문서 필요(임의 규칙 미적용)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;fontSize=10;fontColor=#9C6500;strokeColor=#9C6500;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="s_degraded" target="s_normal">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s_self_normal" value="가드: 전부 FRESH&#10;(전이 없음)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=9;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=-20;" edge="1" parent="1" source="s_normal" target="s_normal">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="150"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s_self_degraded" value="가드: 하나 이상 STALE&#10;(DEGRADED 유지)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=9;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=-20;" edge="1" parent="1" source="s_degraded" target="s_degraded">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="840" y="150"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="s_note" value="REQ-SW-F-001~003: 형식/범위 오류 입력은 이 상태전이와 별개로 RejectionGate가&#10;안전 판단 로직 평가 이전에 입력 단위로 거절한다(INVALID). NORMAL/DEGRADED 상태 자체를 변경하지 않는다&#10;(ENG-SWE2-001 8.1 미확정 2 — OEM 확인 필요, 임의로 연동시키지 않음).&#10;&#10;구독자 통지: 상태가 실제로 변경된 경우에만 FN-STATE-005(_notify_subscribers)가 등록된 콜백을&#10;(이전상태, 신규상태) 인자로 동기 호출한다. 콜백 내부 예외는 개별 격리되어 다른 구독자에 전파되지 않는다." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFF2CC;strokeColor=#BF9000;fontColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="480" width="960" height="140" as="geometry"/>
        </mxCell>
